{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash .claude/skills/codemap/generate.sh)",
      "Bash(python3 tools/sandbox/promote.py:*)",
      "Bash(python3 tools/sandbox/reset.py:*)",
      "Bash(python3 tools/sandbox/seed.py:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/skills/codemap/generate.sh >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
